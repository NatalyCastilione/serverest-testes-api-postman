{
  "info": {
    "_postman_id": "14191cb1-201b-4868-8205-68f918910ff6",
    "name": "ServeRest - Testes de API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "59072278",
    "_collection_link": "https://go.postman.co/collection/59072278-14191cb1-201b-4868-8205-68f918910ff6?source=collection_link"
  },
  "item": [
    {
      "name": "Cadastrar produtos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Produto cadastrado com sucesso\", () => {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Mensagem de sucesso\", () => {\r\n    pm.expect(pm.response.json().message).to.eql(\"Cadastro realizado com sucesso\");\r\n});\r\n\r\npm.environment.set(\"produtoId\", pm.response.json()._id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"nomeProduto\", \"Produto \" + Date.now());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"{{nomeProduto}}\",\r\n  \"preco\": 13000,\r\n  \"descricao\": \"Celular\",\r\n  \"quantidade\": 90\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"fulano@qa.com\",\r\n  \"password\": \"teste\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Buscar por produto ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Produto encontrado\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"ID bate com cadastro\", () => {\r\n    pm.expect(pm.response.json()._id).to.eql(pm.environment.get(\"produtoId\"));\r\n });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/{{produtoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "{{produtoId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Editar produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Produto editado\", () => {\r\n    pm.response.to.have.status(200);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"{{nomeProduto}}\",\r\n  \"preco\": 100,\r\n  \"descricao\": \"Descrição editada\",\r\n  \"quantidade\": 50\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/produtos/{{produtoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "{{produtoId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Deletar produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Produto excluído\", () => {\r\n    pm.response.to.have.status(200);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/{{produtoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "{{produtoId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const postRequest = {\r",
          "    url: pm.environment.get(\"baseUrl\") + \"/login\",\r",
          "    method: \"POST\",\r",
          "    header: {\r",
          "        \"Content-Type\": \"application/json\"\r",
          "    },\r",
          "    body: {\r",
          "        mode: \"raw\",\r",
          "        raw: JSON.stringify({\r",
          "            email: \"fulano@qa.com\",\r",
          "            password: \"teste\"\r",
          "        }),\r",
          "        options: {\r",
          "            raw: {\r",
          "                language: \"json\"\r",
          "            }\r",
          "        }\r",
          "    }\r",
          "};\r",
          "\r",
          "pm.sendRequest(postRequest, function (err, res) {\r",
          "    if (err) {\r",
          "        console.log(\"Erro na requisição:\", err);\r",
          "        return;\r",
          "    }\r",
          "\r",
          "    console.log(\"Status:\", res.code);\r",
          "    const responseJson = res.json();\r",
          "    console.log(\"Resposta:\", responseJson);\r",
          "\r",
          "    if (!responseJson.authorization) {\r",
          "        console.log(\"Login falhou, sem authorization na resposta\");\r",
          "        return;\r",
          "    }\r",
          "\r",
          "    const token = responseJson.authorization.split(\" \")[1];\r",
          "    pm.environment.set(\"token\", token);\r",
          "    console.log(\"Token salvo:\", token);\r",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ]
}